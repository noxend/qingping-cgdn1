{
  "name": "qingping-cgdn1",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "npm run build -w cgdn1-web",
    "dev": "npm run dev -w cgdn1-web",
    "lint": "npm run lint -w cgdn1-web && eslint tools firmware/test",
    "format": "npm run format:js && npm run format:py && npm run format:c",
    "format:check": "npm run format:check:js && npm run format:check:py && npm run format:check:c",
    "format:js": "prettier --write .",
    "format:check:js": "prettier --check .",
    "format:py": "uvx ruff@0.17.0 format .",
    "format:check:py": "uvx ruff@0.17.0 format --check .",
    "format:c": "git ls-files -z '*.c' '*.h' '*.cpp' | xargs -0 uvx clang-format@23.1.3 -i",
    "format:check:c": "git ls-files -z '*.c' '*.h' '*.cpp' | xargs -0 uvx clang-format@23.1.3 --dry-run --Werror"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=24.2"
  }
}
