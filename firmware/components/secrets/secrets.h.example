#pragma once
// Optional: a release build needs no secrets.h. Copy this file to secrets.h (gitignored)
// only for the development switches below. The device's passwords are not here: the setup
// AP password is generated on the device and shown in its menu, and the config password
// is chosen on the setup page; both live in nvs_cfg (components/system/creds.c).
//
// One exception, for a device that ran a build from before 1.0.0-rc2: the migration build
// (idf.py -B build-migrate -DDEV_BUILD=1 -DCGDN1_MIGRATE=1 build) reads the old
//   #define CONFIG_PASS "..."
// from here and stores its hash on the device, so that password keeps working.

// The DEV_* switches below only compile with `idf.py -DDEV_BUILD=1 build`; a
// normal build fails while any is on, so a bench setting cannot ship by mistake.
// A build with any on reports "dev":true in GET /status.

// Optional. 1 serves the diagnostics and test endpoints (/status details, /touch,
// /oled, /gpio, /i2c) without the config password, for development with the Developer page.
// Anyone on the network can then drive the panel, the LED and the pins. Leave it at
// 0 (or delete it) for any device that is not on a trusted bench. Firmware upload
// still needs the config password.
#define DEV_OPEN_DIAGNOSTICS 0

// Optional, development only. 1 confirms every new image at boot instead of after 60 s of
// health, so a build that resets can be watched in /status instead of being rolled back.
// Leave it at 0 for any device whose recovery depends on the automatic rollback.
#define DEV_EARLY_CONFIRM 0

// Optional, development only. Points the firmware release channel at a test stand
// instead of https://cgdn1.swithy.com: the device reads <origin>/firmware.json and
// accepts only images under <origin>/fw/. A plain http:// stand shows the update but
// cannot install it (esp_https_ota refuses http). Leave it undefined otherwise.
// #define DEV_FW_ORIGIN "http://192.168.10.20:8099"
